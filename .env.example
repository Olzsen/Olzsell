# Required for Telegram interface
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=123456789

# Replace with a long random secret
API_KEY=replace-with-a-random-secret-at-least-32-chars

# SQLite default; change to postgresql+asyncpg://user:password@localhost:5432/olzsell for PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/olzsell.db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_PLUGIN_UPLOAD_MB=1

# Optional secrets; local only. Adapter defaults to demo mode and makes no Playerok calls.
PLAYEROK_TOKEN=
PLAYEROK_USER_AGENT=
PLAYEROK_EXTRA_COOKIES_JSON=
PLAYEROK_MODE=demo
